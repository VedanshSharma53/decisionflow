# Copy this file to .env (same folder) and fill in the values.

# Port the API server listens on (the React app proxies /api and /socket.io to it)
PORT=4000

# Any long random string; used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# AI: "mock" works with no key (free, rule-based). Use "claude" for the real AI.
AI_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Used to turn "Friday" / "next week" into real dates
TIMEZONE=Asia/Kolkata
